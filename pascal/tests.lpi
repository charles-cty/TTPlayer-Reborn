          <BuildMacros><Count Value="1"/><Item1><Identifier Value="BuildPlatform"/></Item1></BuildMacros>
          <CodeGeneration>
            <Optimizations>
              <OptimizationLevel Value="2"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="True"/>
              <DebugInfoType Value="dsDwarf3"/>
              <UseLineInfoUnit Value="True"/>
            </Debugging>
          </Linking>
          <Other>
