          <Conditionals Value="if (TargetOS=&apos;win32&apos;) or (TargetOS=&apos;win64&apos;) then&#10;  BuildPlatform := &apos;windows&apos;&#10;else&#10;  BuildPlatform := TargetOS;"/>
          <BuildMacros><Count Value="1"/><Item1><Identifier Value="BuildPlatform"/></Item1></BuildMacros>
          <CodeGeneration>
            <Optimizations>
              <OptimizationLevel Value="2"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
