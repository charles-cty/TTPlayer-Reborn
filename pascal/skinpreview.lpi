<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="True"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="None"/>
      <Title Value="skinpreview"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True/PM_V2"/>
      </XPManifest>
      <UseDefaultCompilerOptions Value="True"/>
    </General>
    <BuildModes Count="2">
      <Item1 Name="Default" Default="True"/>
      <Item2 Name="HeapTrc">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="bin/skinpreview_heaptrc"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <OtherUnitFiles Value="src/skin;src/render;src/backend;src/ui;src/ui/platform;src/playlist;src/lyric;src/debug;src/config"/>
            <UnitOutputDirectory Value="lib/skinpreview_heaptrc/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <IncludeAssertionCode Value="True"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
              <StackChecks Value="True"/>
            </Checks>
            <Optimizations>
              <OptimizationLevel Value="1"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="True"/>
              <UseLineInfoUnit Value="True"/>
              <UseHeaptrc Value="True"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-dENABLE_HEAPTRC"/>
          </Other>
        </CompilerOptions>
      </Item2>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages Count="3">
      <Item1>
        <PackageName Value="BGRABitmapPack"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
      <Item3>
        <PackageName Value="LazUtils"/>
      </Item3>
    </RequiredPackages>
    <Units Count="1">
      <Unit0>
        <Filename Value="skinpreview.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/skinpreview"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="src/skin;src/render;src/backend;src/ui;src/ui/platform;src/playlist;src/lyric;src/debug;src/config"/>
      <UnitOutputDirectory Value="lib/skinpreview/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <Optimizations>
        <OptimizationLevel Value="2"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="True"/>
        <UseLineInfoUnit Value="True"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
